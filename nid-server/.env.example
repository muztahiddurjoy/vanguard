# Copy to .env and fill in. Every key is optional in development.

ENVIRONMENT=development

# If set, every /v1 request must send "X-API-Key: <NID_API_KEY>".
# Empty disables the check, which is refused when ENVIRONMENT=production.
NID_API_KEY=

# Minimum fuzzy score (0-100) for a name, father's name or mother's name to match.
NAME_MATCH_THRESHOLD=85

# Citizens file. Leave unset to use the bundled app/data/citizens.json.
# DATA_FILE=/srv/data/citizens.json
