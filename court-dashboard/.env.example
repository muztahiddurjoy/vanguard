# Copy to .env.local. Without VITE_API_URL the dashboard shows its built-in court records.

# The DLAS backend (server/), e.g. http://localhost:8000. Its CORS_ORIGINS must
# include this dashboard's address (http://localhost:5175 by default).
VITE_API_URL=

# The backend's API_TOKEN, if it has one.
VITE_API_TOKEN=
