# Copy to .env and fill in. Every key is optional in development:
# without credentials, SMS runs in dry-run mode, AI agents use their
# rule-based path, and telephony answers with a spoken fallback.

ENVIRONMENT=development
DATABASE_URL=sqlite:///./dlas.db
# The DLAO, panel lawyers', court and jail dashboards.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176
# If set, every request must send "Authorization: Bearer <API_TOKEN>".
API_TOKEN=
# DEBUG also logs what callers said and the replies (sensitive: local testing only).
LOG_LEVEL=INFO

# Secret for hashing National ID numbers. Changing it breaks NID matching
# against existing records.
NID_HASH_KEY=change-me

# District this DLAO office serves (used for jurisdiction checks).
OFFICE_DISTRICT=Rangpur
TIMEZONE=Asia/Dhaka

# The agents' model (optional): anthropic (Claude) or openai. Without the
# chosen provider's key the agents stay rule-based.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5

# OpenAI: the agents' model when LLM_PROVIDER=openai, and live speech-to-text
# for the phone lines whenever OPENAI_API_KEY is set. Without it, callers hear
# a fallback message and the call ends.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_STT_MODEL=gpt-live-transcribe
# minimal | low | medium | high | xhigh: earlier text, or a more accurate final transcript
OPENAI_STT_DELAY=low
# Silence that ends a caller's turn, and the loudness below which audio is never speech
STT_END_OF_TURN_MS=700
# While the caller says what happened, before any question: a story has pauses
STT_STORY_END_OF_TURN_MS=1200
STT_MIN_SPEECH_RMS=500

# Twilio media streams. start.sh opens its ngrok tunnel on this domain and serves
# the dashboards there too (/dlao-dashboard/, /lawyer-dashboard/ and so on).
PUBLIC_BASE_URL=https://example.ngrok.app
TWILIO_AUTH_TOKEN=
TWILIO_VALIDATE_SIGNATURES=false

# ElevenLabs TTS (ulaw_8000 for telephony)
ELEVENLABS_API_KEY=
# A voice that speaks Bangla natively (from the ElevenLabs voice library)
ELEVENLABS_VOICE_ID=
# Must speak Bangla: eleven_v3 does; eleven_flash_v2_5 and the turbo models do not
# (they read Bangla with a Hindi accent). GET /v1/models lists each model's languages.
ELEVENLABS_MODEL_ID=eleven_v3
# A reply with no audio after this long is requested again (0: off)
ELEVENLABS_FIRST_AUDIO_TIMEOUT_S=2.5
# How much faster than generated the line speaks, same pitch (0.5-2; 1 = as generated)
VOICE_SPEED=1.2
# Audio held back at the start of each reply so it plays without gaps (0: off)
VOICE_START_BUFFER_S=0.6

# NID registry (nid-server/). Without it, callers are recorded as unverified,
# and courts' and jails' e-KYC checks answer "unavailable".
NID_SERVER_URL=http://localhost:8100
NID_SERVER_API_KEY=

# The AI query helpline printed in SMS (its Twilio webhook: /telephony/voice?line=helpline)
HELPLINE_NUMBER=16430

# Mediation: a party who misses this many sessions in a row is looked for through
# their Union Digital Centre, which is sent the next date.
MEDIATION_NO_SHOW_LIMIT=2
# How long a court's or jail's e-KYC check can be used for an application (minutes).
EKYC_CHECK_VALID_MINUTES=120

# ADN SMS gateway
ADNSMS_API_KEY=
ADNSMS_API_SECRET=
ADNSMS_BASE_URL=https://portal.adnsms.com
SMS_DRY_RUN=true
# When set, only these numbers (comma-separated) get real SMS; others are a dry run.
SMS_ALLOWLIST=
