# Read only when a release build is bundled (NODE_ENV=production): it calls the
# deployed backend (deploy/README.md). Development keeps the emulator's default.
# The backend's API token stays out of git: put EXPO_PUBLIC_API_TOKEN in
# .env.production.local (ignored by git), or enter it in Settings.
EXPO_PUBLIC_API_URL=https://dlas-api.appbaksho.com
